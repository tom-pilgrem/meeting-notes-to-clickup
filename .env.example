# Anthropic API key, used for the extraction call (claude-haiku-4-5)
ANTHROPIC_API_KEY=

# ClickUp personal API token (or OAuth token) with access to the target list
CLICKUP_API_TOKEN=

# Path to a Google service account JSON key file. The service account's
# email must be shared (Viewer access) on the watched Drive folder.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
