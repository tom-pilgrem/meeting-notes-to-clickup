# Anthropic API key, used for the extraction call (claude-haiku-4-5)
ANTHROPIC_API_KEY=

# ClickUp personal API token (or OAuth token) with access to the target list
CLICKUP_API_TOKEN=

# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
# (Desktop app credential type). First run opens a browser to consent; the
# resulting token is cached at GOOGLE_OAUTH_TOKEN_FILE and auto-refreshed.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=./token.json
